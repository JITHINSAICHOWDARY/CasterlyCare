# ---- Server ----
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_SECRET=replace_this_with_a_long_random_string

# ---- Hidden admin account (created by `npm run seed`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@lannistercare.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Database ----
# Leave DATABASE_URL unset for local development: a SQLite file will be
# created automatically at backend/data/lannister_care.sqlite
# For production, set this to your Postgres connection string, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=
# PG_SSL=true

# ---- LLM (Kingslayer chatbot + Diet safety checker) ----
# Works with any OpenAI-compatible chat completions API, including Grok.
# Leave blank to run in rule-based fallback mode (fully functional demo).
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# ---- OTP login by phone (2Factor.in SMS) ----
# From your 2Factor.in dashboard. Leave blank to run in fallback mode: the
# code is logged server-side and also returned in the API response as
# `devCode` so the flow is testable without an SMS account.
TWOFACTOR_API_KEY=

# ---- Google Sign-In ----
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
# Leave blank to disable the Google sign-in endpoint (button won't be shown either).
GOOGLE_CLIENT_ID=

# Hospital timezone for appointment dates/times (IANA name)
APP_TIMEZONE=Asia/Kolkata
